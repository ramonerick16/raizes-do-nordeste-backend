                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "T09 Canal de pedido ausente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
