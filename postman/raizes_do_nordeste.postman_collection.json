            "body": {
              "mode": "raw",
              "raw": "{\"unidadeId\": 1, \"itens\": [{\"produtoId\": 1, \"quantidade\": 1}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
