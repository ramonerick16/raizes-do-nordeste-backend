              }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\"unidadeId\": 1, \"canalPedido\": \"TOTEM\", \"itens\": [{\"produtoId\": 1, \"quantidade\": 999999}], \"formaPagamento\": \"MOCK\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "T11 Produto inexistente",
          "request": {
            "method": "POST",
