              }
            ],
            "url": "{{baseUrl}}/estoques/movimentacoes",
            "body": {
              "mode": "raw",
              "raw": "{\"unidadeId\": 1, \"produtoId\": 1, \"tipo\": \"ENTRADA\", \"quantidade\": 1}",
              "options": {
