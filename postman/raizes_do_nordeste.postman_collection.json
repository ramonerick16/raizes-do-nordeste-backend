              }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\"unidadeId\": 1, \"canalPedido\": \"TOTEM\", \"itens\": [{\"produtoId\": 99999, \"quantidade\": 1}], \"formaPagamento\": \"MOCK\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cenário recusado",
      "item": [
