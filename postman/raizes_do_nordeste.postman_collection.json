{
  "info": {
    "name": "Raízes do Nordeste — 12 cenários executáveis",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar em sequência depois de python scripts_seed.py. Em execuções posteriores, altere email de cadastro e chaves de idempotência ou reinicie o banco local."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "clienteToken",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Preparação",
      "item": [
        {
          "name": "01 Login de administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@raizes.example.com\", \"senha\": \"AdminDemo@123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"adminToken\",pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Cadastro de cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\"nome\": \"Cliente Postman\", \"email\": \"cliente.postman@example.com\", \"senha\": \"ClienteDemo123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Login de cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"cliente.postman@example.com\", \"senha\": \"ClienteDemo123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"clienteToken\",pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cenários positivos",
      "item": [
        {
          "name": "T01 Login válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@raizes.example.com\", \"senha\": \"AdminDemo@123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "T02 Consulta de produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/produtos?unidadeId=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "T03 Criar pedido com estoque",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\"unidadeId\": 1, \"canalPedido\": \"TOTEM\", \"itens\": [{\"produtoId\": 1, \"quantidade\": 2}], \"formaPagamento\": \"MOCK\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"pedidoId\",pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "T04 Consultar pedidos por canal",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ],
            "url": "{{baseUrl}}/pedidos?canalPedido=TOTEM"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "T05 Pagamento simulado aprovado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pagamentos",
            "body": {
              "mode": "raw",
              "raw": "{\"pedidoId\": \"DYNAMIC\", \"resultado\": \"APROVADO\", \"chaveIdempotencia\": \"postman-pedido-1-v1\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let d=JSON.parse(pm.request.body.raw); d.pedidoId=Number(pm.collectionVariables.get(\"pedidoId\")); pm.request.body.update(JSON.stringify(d));"
                ]
              }
            }
          ]
        },
        {
          "name": "T06 Atualizar status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"EM_PREPARACAO\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cenários negativos",
      "item": [
        {
          "name": "T07 Acesso sem token",
          "request": {
            "method": "GET",
            "header": [],
